;; HyperForge for Linux — kanata config
;; Caps → Hyper layer (tap Esc) · Space → nav layer (tap space)
;;
;; Install: ./install.sh  (rewrites HF_BIN)
;; Run:    kanata -c ~/.config/kanata/hyperforge.kbd

(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  concurrent-tap-hold yes
)

;; US ANSI subset — every layer must match this length/order
(defsrc
  grv 1    2    3 4 5 6 7  8  9  0  - =
  tab q    w    e r t y u  i  o  p  [ ] \
  caps a   s    d f g h j  k  l  ;  ' ret
  lsft z   x    c v b n m  ,  .  /
  lctl lmet lalt spc ralt rctl
  left down up right
  esc bspc
  home end
)

(defvar
  $tap 200
)

(defalias
  cap (tap-hold $tap esc (layer-while-held hyper))
  spc (tap-hold $tap spc (layer-while-held nav))

  sl   (cmd HF_BIN/hyperforge-action win-left)
  sr   (cmd HF_BIN/hyperforge-action win-right)
  st   (cmd HF_BIN/hyperforge-action win-top)
  sb   (cmd HF_BIN/hyperforge-action win-bottom)
  sm   (cmd HF_BIN/hyperforge-action win-max)
  sc   (cmd HF_BIN/hyperforge-action win-center)
  stl  (cmd HF_BIN/hyperforge-action win-tl)
  str  (cmd HF_BIN/hyperforge-action win-tr)
  sbl  (cmd HF_BIN/hyperforge-action win-bl)
  sbr  (cmd HF_BIN/hyperforge-action win-br)
  smin (cmd HF_BIN/hyperforge-action win-min)
  scls (cmd HF_BIN/hyperforge-action win-close)
  snx  (cmd HF_BIN/hyperforge-action win-next)
  sund (cmd HF_BIN/hyperforge-action win-undo)
  term (cmd HF_BIN/hyperforge-action term)
  brws (cmd HF_BIN/hyperforge-action browser)
  edit (cmd HF_BIN/hyperforge-action editor)
  files (cmd HF_BIN/hyperforge-action files)
  lock (cmd HF_BIN/hyperforge-action lock)
  host (cmd HF_BIN/hyperforge-action hostname)
  date (cmd HF_BIN/hyperforge-action date)
  goog (cmd HF_BIN/hyperforge-action google-clip)
)

(deflayer base
  grv 1    2    3 4 5 6 7  8  9  0  - =
  tab q    w    e r t y u  i  o  p  [ ] \
  @cap a   s    d f g h j  k  l  ;  ' ret
  lsft z   x    c v b n m  ,  .  /
  lctl lmet lalt @spc ralt rctl
  left down up right
  esc bspc
  home end
)

;; Hold Caps — Hyper
;; 1 browser · 2 editor · 6 max · 7–0 quarters · arrows halves · t term · f files · x close · esc lock
(deflayer hyper
  _   @brws @edit _ _ _ @sm @stl @str @sbl @sbr _ _
  _   _     _     _ @sund @term _ _ @host _ _ _ _ _
  _   _     @smin _ @files _ _ _ _ _ _ _ @sm
  _   @sund @scls @sc _ _ _ @snx @date _ _
  _   _     _     _ _ _
  @sl @sb   @st   @sr
  @lock _
  _ _
)

;; Hold Space — arrows (TouchCursor)
(deflayer nav
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ left down up right _ _ _
  _ _ _ _ _ home _ _ _ end _
  _ _ _ _ _ _
  left down up right
  _ _
  home end
)
