[Unit]
Description=HyperForge kanata (Caps Hyper + Space nav)
Documentation=https://github.com/jreis/hyperforge/tree/main/hyperforge-linux
After=graphical-session.target
PartOf=graphical-session.target
# kanata sleeps 2s on start; a snippet --sync restart during that window
# must not trip systemd's default start-limit.
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=simple
# install.sh rewrites the kanata path. --no-wait is required under systemd.
ExecStart=%h/.local/bin/kanata --no-wait -c %h/.config/kanata/hyperforge.kbd
Restart=on-failure
RestartSec=2

[Install]
# graphical-session.target (not default.target): start with the Hyprland/UWSM
# session so (cmd ...) children inherit WAYLAND_DISPLAY / HYPRLAND_*.
WantedBy=graphical-session.target
