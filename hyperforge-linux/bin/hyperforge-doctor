#!/usr/bin/env bash
# hyperforge-doctor — setup health check for HyperForge Linux
set -euo pipefail

ROOT="${HYPERFORGE_LINUX_ROOT:-$HOME/.local/share/hyperforge-linux}"
ok=0
warn=0
fail=0

pass() { echo "  ✓ $*"; ok=$((ok + 1)); }
soft() { echo "  ~ $*"; warn=$((warn + 1)); }
bad()  { echo "  ✗ $*"; fail=$((fail + 1)); }

have() { command -v "$1" >/dev/null 2>&1; }

echo "HyperForge Linux — Doctor"
echo "root: $ROOT"
echo

echo "Input stack"
if have kanata; then
  pass "kanata $(kanata --version 2>/dev/null | head -1 || echo installed)"
  # HyperForge's window/snippet/clipboard chords are (cmd ...) actions.
  # cargo's default kanata binary is compiled *without* cmd.
  cmd_probe="$(mktemp)"
  cat >"$cmd_probe" <<'EOF'
(defcfg danger-enable-cmd yes)
(defsrc a)
(deflayer base (cmd true))
EOF
  if kanata --check -c "$cmd_probe" >/dev/null 2>&1; then
    pass "kanata was compiled with cmd (required for HyperForge actions)"
  else
    bad "kanata was compiled without cmd — rebuild: cargo install kanata --features cmd"
  fi
  rm -f "$cmd_probe"
else
  soft "kanata not in PATH (primary recommended engine)"
fi
if have keyd; then
  pass "keyd available (alternative)"
else
  soft "keyd not installed (optional)"
fi

# Real keyboards advertise sysrq+kbd+leds. "System Control" / power buttons
# do not — and those are the nodes kanata can still open without the input group.
readable_kbds=0
unreadable_kbds=0
while IFS= read -r ev; do
  [[ -z "$ev" || ! -e "$ev" ]] && continue
  if [[ -r "$ev" ]]; then
    readable_kbds=$((readable_kbds + 1))
  else
    unreadable_kbds=$((unreadable_kbds + 1))
  fi
done < <(awk '
  BEGIN { RS = ""; FS = "\n" }
  /Handlers=.*sysrq.*kbd.*leds/ {
    for (i = 1; i <= NF; i++) {
      if ($i !~ /^H: Handlers=/) continue
      n = split($i, a, /[ \t]+/)
      for (j = 1; j <= n; j++) if (a[j] ~ /^event[0-9]+$/) print "/dev/input/" a[j]
    }
  }
' /proc/bus/input/devices 2>/dev/null)

in_input_group=0
id -nG 2>/dev/null | grep -qE '\b(input|plugdev)\b' && in_input_group=1

if [[ "$readable_kbds" -gt 0 ]]; then
  pass "can read $readable_kbds real keyboard device(s)"
elif [[ "$in_input_group" -eq 1 ]]; then
  soft "in 'input' group but no keyboard is readable in this session — log out / back in"
else
  bad "cannot read any real keyboard — sudo usermod -aG input \"$USER\" then log out"
fi
if [[ "$unreadable_kbds" -gt 0 && "$readable_kbds" -eq 0 ]]; then
  soft "$unreadable_kbds keyboard node(s) exist but are root:input 660 (this is why Caps/arrows do nothing)"
fi

if systemctl --user is-active --quiet hyperforge-kanata.service 2>/dev/null; then
  since="$(systemctl --user show hyperforge-kanata.service -p ActiveEnterTimestamp --value 2>/dev/null || true)"
  regs="$(journalctl --user -u hyperforge-kanata.service --since "${since:-1 hour ago}" --no-pager 2>/dev/null | grep 'registering /dev/input' || true)"
  if [[ -z "$regs" ]]; then
    soft "hyperforge-kanata is running but has not registered any device yet"
  elif printf '%s\n' "$regs" | grep -Eqi 'Keyboard|^.*registering.*Keychron Keychron V5 Max"$' \
    || printf '%s\n' "$regs" | grep -vEi 'System Control|Consumer Control|Mouse' | grep -q registering; then
    pass "kanata registered a real keyboard"
    printf '%s\n' "$regs" | sed 's/^/      /'
  else
    bad "kanata only grabbed a control interface, not the keyboard:"
    printf '%s\n' "$regs" | sed 's/^/      /'
    soft "fix: sudo usermod -aG input \"$USER\" && log out — then systemctl --user restart hyperforge-kanata"
  fi
fi

if [[ -f /dev/uinput ]] || [[ -e /dev/uinput ]]; then
  if [[ -w /dev/uinput ]]; then
    pass "/dev/uinput writable"
  else
    soft "/dev/uinput exists but not writable — check udev / groups"
  fi
else
  soft "/dev/uinput missing — load uinput module"
fi

echo
echo "Compositor / WM"
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  pass "Hyprland session"
elif [[ -n "${SWAYSOCK:-}" ]]; then
  pass "Sway session"
elif [[ -n "${DISPLAY:-}" ]]; then
  pass "X11 DISPLAY=$DISPLAY"
  have wmctrl && pass "wmctrl" || soft "wmctrl missing (X11 snaps)"
  have xdotool && pass "xdotool" || soft "xdotool missing (X11 snaps)"
else
  soft "no HYPRLAND / SWAYSOCK / DISPLAY detected"
fi
have hyprctl && pass "hyprctl" || true
have swaymsg && pass "swaymsg" || true
have jq && pass "jq" || soft "jq recommended for Hyprland snaps"

echo
echo "HyperForge files"
[[ -x "$ROOT/bin/hyperforge-snap" ]] && pass "hyperforge-snap" || bad "hyperforge-snap missing — run install.sh"
[[ -x "$ROOT/bin/hyperforge-action" ]] && pass "hyperforge-action" || bad "hyperforge-action missing"
[[ -x "$ROOT/bin/hyperforge-snippet" ]] && pass "hyperforge-snippet" || soft "hyperforge-snippet missing — run install.sh"
[[ -x "$ROOT/bin/hyperforge-clip" ]] && pass "hyperforge-clip" || soft "hyperforge-clip missing — run install.sh"
[[ -x "$ROOT/bin/hyperforge-pin" ]] && pass "hyperforge-pin" || soft "hyperforge-pin missing — run install.sh"
[[ -x "$ROOT/bin/hyperforge-paste" ]] && pass "hyperforge-paste" || soft "hyperforge-paste missing — run install.sh"
[[ -x "$ROOT/bin/hyperforge-bar" ]] && pass "hyperforge-bar" || soft "hyperforge-bar missing — run install.sh"
have grim && have slurp && pass "grim + slurp (region pin)" \
  || soft "grim + slurp needed for Hyper+N region pin"
python3 -c 'import gi; gi.require_version("Gtk","4.0"); from gi.repository import Gtk' >/dev/null 2>&1 \
  && pass "GTK 4 (pin window)" \
  || soft "GTK 4 + PyGObject needed for the pin window"
have tesseract && pass "tesseract (pin OCR)" || soft "tesseract optional — pin menu OCR"
[[ -f "$HOME/.config/kanata/hyperforge.kbd" ]] && pass "~/.config/kanata/hyperforge.kbd" \
  || soft "kanata config not installed yet"

echo
echo "Snippets (Hyper+,)"
SNIP_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/hyperforge-linux/snippets.conf"
if [[ -f "$SNIP_CONF" ]]; then
  n=$(grep -cE '^[^#=]+=' "$SNIP_CONF" 2>/dev/null || echo 0)
  pass "snippets.conf — $n configured"
else
  soft "no snippets.conf yet — run install.sh (seeds $SNIP_CONF)"
fi
if have omarchy-menu-select; then
  pass "omarchy-menu-select (snippet/clipboard picker)"
elif have rofi; then
  pass "rofi (snippet/clipboard picker)"
elif have wofi; then
  pass "wofi (snippet/clipboard picker)"
else
  soft "install rofi/wofi, or use Omarchy (omarchy-menu-select) for Hyper+, / Hyper+P"
fi

echo
echo "Clipboard history (Hyper+P)"
CLIP_STORE="${XDG_DATA_HOME:-$HOME/.local/share}/hyperforge-linux/clipboard-history.dat"
if [[ -f "$CLIP_STORE" ]]; then
  n=$(wc -l <"$CLIP_STORE" 2>/dev/null | tr -d ' ')
  pass "clipboard-history.dat — $n item(s)"
else
  soft "no clipboard history yet — copy something after the watcher is running"
fi
if systemctl --user is-active --quiet hyperforge-clipboard.service 2>/dev/null; then
  pass "hyperforge-clipboard.service running"
else
  soft "hyperforge-clipboard.service not running — systemctl --user enable --now hyperforge-clipboard.service"
fi

echo
echo "Optional helpers"
have notify-send && pass "notify-send" || soft "notify-send (desktop toasts)"
have wtype && pass "wtype (type into focused apps on Wayland)" || soft "wtype or ydotool for typing into focused apps"
have wl-copy && pass "wl-copy" || soft "wl-clipboard for Wayland copy"

echo
echo "macOS-only (no Linux equivalent shipped here): Ollama command bar,"
echo "Shortcuts integration, AX recipe recording, profiles/auto-triggers."

echo
echo "Summary: $ok ok · $warn warnings · $fail failures"
if [[ "$fail" -gt 0 ]]; then exit 1; fi
exit 0
