#!/usr/bin/env bash
# hyperforge-action — small command palette for Hyper chords (kanata cmd targets).
# Usage: hyperforge-action <id>
# Aligned with macOS HyperForge 0.4.x core chords where practical.
set -euo pipefail

ROOT="${HYPERFORGE_LINUX_ROOT:-$HOME/.local/share/hyperforge-linux}"
SNAP="${ROOT}/bin/hyperforge-snap"
have() { command -v "$1" >/dev/null 2>&1; }

notify() {
  local msg="$1"
  if have notify-send; then
    notify-send -a HyperForge -t 1500 "HyperForge" "$msg" 2>/dev/null || true
  fi
}

type_text() {
  local t="$1"
  if have wtype; then wtype "$t"
  elif have ydotool; then ydotool type "$t"
  elif have xdotool; then xdotool type --clearmodifiers "$t"
  else
    if have wl-copy; then printf '%s' "$t" | wl-copy; notify "Copied (no typer): $t"
    elif have xclip; then printf '%s' "$t" | xclip -selection clipboard; notify "Copied (no typer): $t"
    else echo "$t"; fi
  fi
}

clip_get() {
  if have wl-paste; then wl-paste 2>/dev/null || true
  elif have xclip; then xclip -selection clipboard -o 2>/dev/null || true
  else echo ""
  fi
}

clip_set() {
  local t="$1"
  if have wl-copy; then printf '%s' "$t" | wl-copy
  elif have xclip; then printf '%s' "$t" | xclip -selection clipboard
  else echo "$t"
  fi
}

id="${1:-}"
case "$id" in
  ""|-h|--help)
    echo "usage: $0 <action-id>"
    echo "  snaps: win-left win-right win-top win-bottom win-max win-center"
    echo "         win-tl win-tr win-bl win-br win-min win-close win-next win-undo win-tile"
    echo "  apps:  term browser editor files"
    echo "  sys:   lock hostname date google-clip plain-paste open-url always-on-top"
    exit 0
    ;;
  win-left)   exec "$SNAP" left ;;
  win-right)  exec "$SNAP" right ;;
  win-top)    exec "$SNAP" top ;;
  win-bottom) exec "$SNAP" bottom ;;
  win-max)    exec "$SNAP" max ;;
  win-center) exec "$SNAP" center ;;
  win-tl)     exec "$SNAP" tl ;;
  win-tr)     exec "$SNAP" tr ;;
  win-bl)     exec "$SNAP" bl ;;
  win-br)     exec "$SNAP" br ;;
  win-min)    exec "$SNAP" min ;;
  win-close)  exec "$SNAP" close ;;
  win-next)   exec "$SNAP" next-mon ;;
  win-undo)   exec "$SNAP" undo ;;
  win-tile)   exec "$SNAP" tile ;;

  term)
    if have ghostty; then exec ghostty
    elif have kitty; then exec kitty
    elif have alacritty; then exec alacritty
    elif have wezterm; then exec wezterm
    elif have gnome-terminal; then exec gnome-terminal
    elif have x-terminal-emulator; then exec x-terminal-emulator
    else notify "No terminal found"; exit 1
    fi
    ;;
  browser)
    if have firefox; then exec firefox
    elif have google-chrome; then exec google-chrome
    elif have chromium; then exec chromium
    elif have brave-browser; then exec brave-browser
    elif have xdg-open; then exec xdg-open https://
    else notify "No browser found"; exit 1
    fi
    ;;
  editor)
    if have zed; then exec zed
    elif have code; then exec code
    elif have nvim; then exec x-terminal-emulator -e nvim 2>/dev/null || exec nvim
    else notify "No editor found"; exit 1
    fi
    ;;
  files)
    if have nautilus; then exec nautilus
    elif have dolphin; then exec dolphin
    elif have thunar; then exec thunar
    elif have pcmanfm; then exec pcmanfm
    elif have xdg-open; then exec xdg-open "$HOME"
    else notify "No file manager"; exit 1
    fi
    ;;

  lock)
    if have loginctl; then loginctl lock-session
    elif have xdg-screensaver; then xdg-screensaver lock
    elif have gnome-screensaver-command; then gnome-screensaver-command -l
    else notify "No lock command"; exit 1
    fi
    ;;
  hostname)
    clip_set "$(hostname)"
    notify "Hostname copied"
    ;;
  date)
    type_text "$(date +%Y-%m-%d)"
    ;;
  google-clip)
    q="$(clip_get)"
    if [[ -z "$q" ]]; then notify "Clipboard empty"; exit 1; fi
    enc="$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$q")"
    xdg-open "https://www.google.com/search?q=${enc}" >/dev/null 2>&1 &
    ;;
  plain-paste)
    # Strip via round-trip as plain text
    q="$(clip_get)"
    clip_set "$q"
    if have wtype; then wtype -M ctrl v -m ctrl
    elif have xdotool; then xdotool key --clearmodifiers ctrl+v
    else notify "Clipboard is plain text (no paste key)"; fi
    ;;
  open-url)
    q="$(clip_get)"
    url="$(printf '%s' "$q" | grep -Eo 'https?://[^[:space:]]+' | head -1 || true)"
    if [[ -z "$url" ]]; then notify "No URL in clipboard"; exit 1; fi
    xdg-open "$url" >/dev/null 2>&1 &
    ;;
  always-on-top)
    if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && have hyprctl; then
      hyprctl dispatch pin active >/dev/null 2>&1 || hyprctl dispatch togglefloating >/dev/null
      notify "Pin / float toggled"
    elif [[ -n "${SWAYSOCK:-}" ]] && have swaymsg; then
      swaymsg sticky toggle >/dev/null
      notify "Sticky toggled"
    else
      notify "Always-on-top not supported on this WM"
      exit 1
    fi
    ;;
  *)
    echo "unknown action: $id" >&2
    exit 2
    ;;
esac
