{
  "title": "HyperForge — Caps Lock as Hyper (F18)",
  "rules": [
    {
      "description": "Caps Lock to F18 (Hyper trigger, alone = Escape)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "f18" }],
          "to_if_alone": [{ "key_code": "escape" }]
        }
      ]
    }
  ]
}
