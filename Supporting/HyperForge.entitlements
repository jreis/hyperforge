<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Non-sandboxed companion app (CGEvent tap + AX require full disk access via Accessibility). -->
	<!-- Hardened Runtime entitlements for Developer ID / notarization. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Allow loading system frameworks used by Accessibility / event taps. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
